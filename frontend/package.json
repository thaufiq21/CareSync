    "lucide-react": "^0.468.0",
    "recharts": "^2.13.3",
    "axios": "^1.7.7",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.5.4",
    "react-hot-toast": "^2.4.1",
    "date-fns": "^4.1.0"
