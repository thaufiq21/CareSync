# CareSync Environment Configuration
# Copy this file to .env and fill in actual values for local development
# NEVER commit the .env file to version control

# Application
APP_ENV=development
APP_NAME=CareSync
DEBUG=true

# Frontend URL (used by backend CORS)
FRONTEND_URL=http://localhost:5173

# Backend URL (used by frontend API client)
VITE_API_URL=http://localhost:8000

# Database (SQLite for local dev, change to postgresql:// for production)
DATABASE_URL=sqlite:///./caresync.db

# Session Security - generate a long random string for production
SESSION_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_IN_PRODUCTION

# First Admin Account (used ONLY by the safe seed/init script)
# Never use these defaults in production
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@caresync.demo
ADMIN_PASSWORD=CHANGE_ME_BEFORE_USE

# Optional: External AI Provider (leave blank to use local FAQ fallback)
# AI_PROVIDER=openai
# AI_API_KEY=
# AI_MODEL=gpt-4o-mini
# AI_MAX_TOKENS=500

# Demo mode flag (adds demo banner, enables demo data seeding)
DEMO_MODE=true
